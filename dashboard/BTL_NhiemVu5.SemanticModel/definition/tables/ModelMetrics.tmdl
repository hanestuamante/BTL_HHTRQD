	partition ModelMetrics = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\model_metrics.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"market", type text},
					{"model", type text},
					{"mape", type number},
					{"mdape", type number},
					{"rmse", type number},
					{"mae", type number},
					{"r2", type number},
					{"acc10", type number},
					{"acc20", type number}
					}),
				Result = Typed
			in
				Result
