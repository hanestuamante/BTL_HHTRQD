	partition KingSales = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\fact_king.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"source_row_id", Int64.Type},
					{"id", type text},
					{"date", type date},
					{"price", type number},
					{"zipcode", type text},
					{"lat", type number},
					{"long", type number},
					{"bedrooms", Int64.Type},
					{"bathrooms", type number},
					{"sqft_living", Int64.Type},
					{"sqft_lot", Int64.Type},
					{"grade", Int64.Type},
					{"condition", Int64.Type},
					{"view", Int64.Type},
					{"waterfront", Int64.Type},
					{"house_age", Int64.Type},
					{"is_renovated", Int64.Type},
					{"distance_to_center_km", type number},
					{"zero_room_flag", Int64.Type},
					{"predicted_price", type number},
					{"residual", type number},
					{"residual_pct", type number},
					{"residual_pct_rf", type number},
					{"residual_pct_lr", type number},
					{"residual_pct_conservative", type number},
					{"undervalued_20pct", Int64.Type},
					{"models_agree_undervalued", Int64.Type},
					{"is_latest_sale", Int64.Type},
					{"sale_year", Int64.Type},
					{"sale_month", type text},
					{"price_band", type text},
					{"discount_pct", type number},
					{"discount_conservative_pct", type number},
					{"upside_usd", type number},
					{"zip_top", type text}
					}),
				Result = Typed
			in
				Result
