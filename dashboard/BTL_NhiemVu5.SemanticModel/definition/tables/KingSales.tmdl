					{"house_age", Int64.Type},
					{"is_renovated", Int64.Type},
					{"distance_to_center_km", type number},
					{"zero_room_flag", Int64.Type},
					{"predicted_price", type number},
					{"residual", type number},
					{"residual_pct", type number},
					{"residual_pct_rf", type number},
					{"residual_pct_lr", type number},
					{"residual_pct_conservative", type number},
					{"undervalued_20pct", Int64.Type},
					{"models_agree_undervalued", Int64.Type},
					{"is_latest_sale", Int64.Type},
					{"sale_year", Int64.Type},
					{"sale_month", type text},
					{"price_band", type text},
					{"discount_pct", type number},
					{"discount_conservative_pct", type number},
					{"upside_usd", type number},
					{"zip_top", type text}
					}),
				Result = Typed
			in
				Result
