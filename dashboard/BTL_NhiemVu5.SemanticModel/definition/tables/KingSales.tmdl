	partition KingSales = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\fact_king.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"source_row_id", Int64.Type},
					{"id", type text},
					{"date", type date},
					{"price", type number},
					{"zipcode", type text},
					{"lat", type number},
					{"long", type number},
					{"bedrooms", type number},
