table SegmentCompare
	lineageTag: 55774956-6e33-47d5-a5f1-cec96cab5d2f

	column segment
		dataType: string
		sourceColumn: segment
		lineageTag: 27776ee9-9033-443c-831a-b87f7b54bf8d
	column mape_lr
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_lr
		lineageTag: 14c171a8-0727-4014-b635-73acb45e9abd
	column mape_xgb
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_xgb
		lineageTag: 0ee10f8e-5b46-4d07-8881-c296ad142624

	partition SegmentCompare = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\segment_compare.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"segment", type text},
					{"mape_lr", type number},
					{"mape_xgb", type number}
					}),
				Result = Typed
			in
				Result
