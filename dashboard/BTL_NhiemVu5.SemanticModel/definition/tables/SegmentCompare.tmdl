table SegmentCompare
	lineageTag: 62b0b31f-ee15-4094-9014-4222b3558b0f

	column 'Khúc giá'
		dataType: string
		sourceColumn: segment
		lineageTag: dc99a6a8-dbea-41d7-a9c9-d5ac5be22efe
	column 'MAPE Linear'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_lr
		lineageTag: 64de27e3-22e5-45b7-877c-88d7f6274deb
	column 'MAPE XGBoost'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_xgb
		lineageTag: d00c7c9d-23fd-4648-84f4-15bf38c3a564

	partition SegmentCompare = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\segment_compare.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"segment", type text},
					{"mape_lr", type number},
					{"mape_xgb", type number}
					}),
				Result = Typed
			in
				Result
