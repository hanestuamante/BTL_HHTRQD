table SegmentCompare
	lineageTag: 069422f5-e446-4e07-b834-e5cdbed78ab6

	column segment
		dataType: string
		sourceColumn: segment
		lineageTag: c41f2e90-9601-4ccc-9479-7c172c99bf28
	column mape_lr
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_lr
		lineageTag: 36782499-8837-4c2b-9264-69ba942ccf13
	column mape_xgb
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_xgb
		lineageTag: b4f33d4a-6092-4819-9525-536f76e745d8

	partition SegmentCompare = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\segment_compare.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"segment", type text},
					{"mape_lr", type number},
					{"mape_xgb", type number}
					}),
				Result = Typed
			in
				Result
