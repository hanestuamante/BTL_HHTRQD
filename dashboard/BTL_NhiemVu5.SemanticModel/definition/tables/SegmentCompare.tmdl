table SegmentCompare
	lineageTag: 3fcff99a-0efb-4491-90d8-ff95dccc8e3d

	column 'Khúc giá'
		dataType: string
		sourceColumn: segment
		lineageTag: 63214de4-6bec-4a0a-95e3-0ffd7aed8cba
	column 'MAPE Linear'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_lr
		lineageTag: 1bf95b2b-3a2e-446c-adc4-604ce3ab5efe
	column 'MAPE XGBoost'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_xgb
		lineageTag: ad124e04-1d95-49cd-b0ac-325ed0488115

	partition SegmentCompare = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\segment_compare.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"segment", type text},
					{"mape_lr", type number},
					{"mape_xgb", type number}
					}),
				Result = Typed
			in
				Result
