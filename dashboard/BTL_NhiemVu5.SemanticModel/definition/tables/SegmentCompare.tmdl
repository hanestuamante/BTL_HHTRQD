table SegmentCompare
	lineageTag: b20e9044-4c41-4de6-a9fc-8d1387b7018b

	column 'Khúc giá'
		dataType: string
		sourceColumn: segment
		lineageTag: 4cc30067-3915-48c6-a886-4d02aaa41350
	column 'MAPE Linear'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_lr
		lineageTag: 54eb0d87-e31d-4a0b-8dd6-26b4dcb35637
	column 'MAPE XGBoost'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_xgb
		lineageTag: 2897d566-5755-41e4-9009-1a0a53dd4efb

	partition SegmentCompare = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\segment_compare.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"segment", type text},
					{"mape_lr", type number},
					{"mape_xgb", type number}
					}),
				Result = Typed
			in
				Result
