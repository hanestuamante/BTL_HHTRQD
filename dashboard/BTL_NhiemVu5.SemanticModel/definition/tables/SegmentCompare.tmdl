table SegmentCompare
	lineageTag: 5c608cb8-19f6-48b2-95f7-449d6afdab68

	column 'Khúc giá'
		dataType: string
		sourceColumn: segment
		lineageTag: a68a43f9-554e-4409-bc4c-df494c5f52a4
	column 'MAPE Linear'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_lr
		lineageTag: 3affd51e-c36c-4742-91a5-cd1fe7e5c627
	column 'MAPE XGBoost'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_xgb
		lineageTag: e14b3666-b843-44fc-8dea-27b51b3b212a

	partition SegmentCompare = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\segment_compare.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"segment", type text},
					{"mape_lr", type number},
					{"mape_xgb", type number}
					}),
				Result = Typed
			in
				Result
