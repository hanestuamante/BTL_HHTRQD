table ImportanceTop
	lineageTag: 2f47c447-a0b6-4b6a-a5c1-c4d7f7d5beda

	column feature
		dataType: string
		sourceColumn: feature
		lineageTag: 96d18ad1-4f0f-4a72-8bb4-5b977eafe463
	column mape_increase_pp
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_increase_pp
		lineageTag: 2285eefc-f247-4ee7-aa1d-40e8c1c1336d
	column std_pp
		dataType: double
		summarizeBy: sum
		sourceColumn: std_pp
		lineageTag: 5e15903e-7a93-4b11-84a3-7d7f8b1ef112

	partition ImportanceTop = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\importance_top.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"feature", type text},
					{"mape_increase_pp", type number},
					{"std_pp", type number}
					}),
				Result = Typed
			in
				Result
