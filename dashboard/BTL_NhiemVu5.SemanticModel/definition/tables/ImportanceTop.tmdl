table ImportanceTop
	lineageTag: 277d177f-084a-45d9-9892-1e4366a9230a

	column 'Biến'
		dataType: string
		sourceColumn: feature
		lineageTag: d571aae8-a743-4f44-8483-d37dabacbf70
	column 'MAPE tăng (điểm %)'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_increase_pp
		lineageTag: 8f3dd3ec-dd68-4254-95b1-f818d0a7f0b3
	column 'std_pp'
		dataType: double
		summarizeBy: sum
		sourceColumn: std_pp
		lineageTag: 00beef2c-386d-4d10-b9fe-0f01520de652

	partition ImportanceTop = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\importance_top.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"feature", type text},
					{"mape_increase_pp", type number},
					{"std_pp", type number}
					}),
				Result = Typed
			in
				Result
