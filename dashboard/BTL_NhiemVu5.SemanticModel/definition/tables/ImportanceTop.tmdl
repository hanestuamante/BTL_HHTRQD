table ImportanceTop
	lineageTag: 209642c8-fd8b-4964-9385-2a6b1392de74

	column feature
		dataType: string
		sourceColumn: feature
		lineageTag: 9104d9ce-07ac-43c0-bea1-f07cacc5eb6b
	column mape_increase_pp
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_increase_pp
		lineageTag: b7958716-a93b-441c-974f-ae87f8ab06f9
	column std_pp
		dataType: double
		summarizeBy: sum
		sourceColumn: std_pp
		lineageTag: da18323b-4449-4a70-bcd1-e1a1be852078

	partition ImportanceTop = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\importance_top.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"feature", type text},
					{"mape_increase_pp", type number},
					{"std_pp", type number}
					}),
				Result = Typed
			in
				Result
