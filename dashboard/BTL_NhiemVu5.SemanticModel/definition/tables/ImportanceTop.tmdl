table ImportanceTop
	lineageTag: 9849fb6b-8a82-4c8e-8455-aae39ab67a02

	column 'Biến'
		dataType: string
		sourceColumn: feature
		lineageTag: 6b145009-2e77-4893-8a79-7eac1a4b09fe
	column 'MAPE tăng (điểm %)'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_increase_pp
		lineageTag: 4264923c-7530-42a1-9440-c6400a95cdd1
	column 'std_pp'
		dataType: double
		summarizeBy: sum
		sourceColumn: std_pp
		lineageTag: 69bdb35b-a9c7-43b9-a89b-109e8172c2c1

	partition ImportanceTop = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\importance_top.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"feature", type text},
					{"mape_increase_pp", type number},
					{"std_pp", type number}
					}),
				Result = Typed
			in
				Result
