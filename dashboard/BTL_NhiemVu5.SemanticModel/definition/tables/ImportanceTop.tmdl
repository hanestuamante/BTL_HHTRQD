table ImportanceTop
	lineageTag: 97617aaa-bd4f-477e-ae60-3d2bdcc59e93

	column 'Biến'
		dataType: string
		sourceColumn: feature
		lineageTag: 5568006e-309f-4a07-a030-6342a557b45e
	column 'MAPE tăng (điểm %)'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape_increase_pp
		lineageTag: 22438080-2209-450d-be1b-1eafc1fa20fe
	column 'std_pp'
		dataType: double
		summarizeBy: sum
		sourceColumn: std_pp
		lineageTag: 95ca28a5-45b5-423f-8e42-b23c2e90fc3c

	partition ImportanceTop = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\importance_top.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"feature", type text},
					{"mape_increase_pp", type number},
					{"std_pp", type number}
					}),
				Result = Typed
			in
				Result
