table ChonChiSo
	lineageTag: 12a7cc25-23c7-4c0b-ac50-665fdc3fa3a6

	column 'Chỉ số'
		dataType: string
		sourceColumn: ChiSo
		lineageTag: 4ac75df4-f595-43c0-9735-d82aae24ed3a
	column 'ThuTu'
		dataType: int64
		summarizeBy: sum
		sourceColumn: ThuTu
		lineageTag: 8f7f6db7-3ca4-4c5b-a493-ddf56a61af7e

	partition ChonChiSo = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\chon_chi_so.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"ChiSo", type text},
					{"ThuTu", Int64.Type}
					}),
				Result = Typed
			in
				Result
