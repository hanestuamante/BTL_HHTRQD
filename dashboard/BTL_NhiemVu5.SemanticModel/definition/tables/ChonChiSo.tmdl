table ChonChiSo
	lineageTag: 6b91081f-bf55-415d-954d-d2026c5d3b27

	column 'Chỉ số'
		dataType: string
		sourceColumn: ChiSo
		lineageTag: c12aa183-c7fe-4a6c-b8d6-7f9cccde7742
	column 'ThuTu'
		dataType: int64
		summarizeBy: sum
		sourceColumn: ThuTu
		lineageTag: e18819d8-a6da-4a42-90ef-1ffe006dd097

	partition ChonChiSo = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\chon_chi_so.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"ChiSo", type text},
					{"ThuTu", Int64.Type}
					}),
				Result = Typed
			in
				Result
