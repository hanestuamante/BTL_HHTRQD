table ChonChiSo
	lineageTag: 55bf2df6-cde2-4f90-948e-f4098d19ed1e

	column 'Chỉ số'
		dataType: string
		sourceColumn: ChiSo
		lineageTag: 158a3247-ae21-4ea7-98af-cedef383bd9b
	column 'ThuTu'
		dataType: int64
		summarizeBy: sum
		sourceColumn: ThuTu
		lineageTag: af7ab113-0f93-43ee-b9a9-dbdf39ae7a75

	partition ChonChiSo = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\chon_chi_so.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"ChiSo", type text},
					{"ThuTu", Int64.Type}
					}),
				Result = Typed
			in
				Result
