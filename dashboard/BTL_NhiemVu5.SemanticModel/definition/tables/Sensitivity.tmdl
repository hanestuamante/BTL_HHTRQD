table Sensitivity
	lineageTag: 7352ebe6-7941-4498-bf77-0658b490ba13

	column threshold_pct
		dataType: int64
		summarizeBy: sum
		sourceColumn: threshold_pct
		lineageTag: ee186951-7e3b-4104-86e7-c924a554ccab
	column candidates
		dataType: int64
		summarizeBy: sum
		sourceColumn: candidates
		lineageTag: e71e448f-257d-4fad-954e-ce99f12194b1
	column share_pct
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: aa25b15d-7db0-4d3b-a542-d3a28f0b0090
	column all3
		dataType: int64
		summarizeBy: sum
		sourceColumn: all3
		lineageTag: 11828622-ba60-478c-b5c4-b6c46b86064a
	column over_50pct
		dataType: int64
		summarizeBy: sum
		sourceColumn: over_50pct
		lineageTag: f3852aa9-5418-475c-9e4f-58ac9a5c45e5
	column median_price
		dataType: double
		summarizeBy: sum
		sourceColumn: median_price
		lineageTag: 4dad6a08-2011-485b-8226-8ac2dad910e0
	column enough_20
		dataType: boolean
		sourceColumn: enough_20
		lineageTag: 0d00bec8-c297-49f9-ad30-9b65aa753bdd

	partition Sensitivity = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\sensitivity.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"threshold_pct", Int64.Type},
					{"candidates", Int64.Type},
					{"share_pct", type number},
					{"all3", Int64.Type},
					{"over_50pct", Int64.Type},
					{"median_price", type number},
					{"enough_20", type logical}
					}),
				Result = Typed
			in
				Result
