table Sensitivity
	lineageTag: 03edf331-32f8-40ff-a1c8-ae5e6f15b714

	column 'Ngưỡng (%)'
		dataType: int64
		summarizeBy: sum
		sourceColumn: threshold_pct
		lineageTag: 721546e5-fb00-4e69-b7d3-8cb16fa7b35b
	column 'Số ứng viên'
		dataType: int64
		summarizeBy: sum
		sourceColumn: candidates
		lineageTag: 0a3b2af1-952d-4675-9e86-18a4742a266d
	column 'Tỷ lệ (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: 55199cd9-3ec0-4075-b571-8e21118cfa9f
	column 'all3'
		dataType: int64
		summarizeBy: sum
		sourceColumn: all3
		lineageTag: 0678787a-5a32-49b1-b966-6302405585ff
	column 'over_50pct'
		dataType: int64
		summarizeBy: sum
		sourceColumn: over_50pct
		lineageTag: 2171a9d4-9ce0-4958-87c3-39ac61801534
	column 'Giá trung vị (USD)'
		dataType: double
		summarizeBy: sum
		sourceColumn: median_price
		lineageTag: 2774255a-1417-422b-ae08-2091e82612d9
	column 'enough_20'
		dataType: boolean
		sourceColumn: enough_20
		lineageTag: 9141e09f-6941-443f-8651-fb16b0217319

	partition Sensitivity = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\sensitivity.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"threshold_pct", Int64.Type},
					{"candidates", Int64.Type},
					{"share_pct", type number},
					{"all3", Int64.Type},
					{"over_50pct", Int64.Type},
					{"median_price", type number},
					{"enough_20", type logical}
					}),
				Result = Typed
			in
				Result
