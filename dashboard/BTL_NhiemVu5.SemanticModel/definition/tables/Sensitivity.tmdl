table Sensitivity
	lineageTag: a7138189-52af-4d25-82a0-d24463140ec2

	column 'Ngưỡng (%)'
		dataType: int64
		summarizeBy: sum
		sourceColumn: threshold_pct
		lineageTag: cf204426-dc99-4c8e-a6a6-a3347934f818
	column 'Số ứng viên'
		dataType: int64
		summarizeBy: sum
		sourceColumn: candidates
		lineageTag: 00950542-a992-43b5-9cef-5ceba6e3b37c
	column 'Tỷ lệ (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: 935bfdd9-f52a-4562-ace9-f61d6e3d61ad
	column 'all3'
		dataType: int64
		summarizeBy: sum
		sourceColumn: all3
		lineageTag: 87c387ac-74e0-4a81-98dd-805705b7603e
	column 'over_50pct'
		dataType: int64
		summarizeBy: sum
		sourceColumn: over_50pct
		lineageTag: 25de72a8-2c08-4847-999c-9e4d7bf968ee
	column 'Giá trung vị (USD)'
		dataType: double
		summarizeBy: sum
		sourceColumn: median_price
		lineageTag: ef6e9675-696d-4e42-9f4f-9599ef51df46
	column 'enough_20'
		dataType: boolean
		sourceColumn: enough_20
		lineageTag: 9212451a-666f-4aef-9b96-a774476c1a96

	partition Sensitivity = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\sensitivity.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"threshold_pct", Int64.Type},
					{"candidates", Int64.Type},
					{"share_pct", type number},
					{"all3", Int64.Type},
					{"over_50pct", Int64.Type},
					{"median_price", type number},
					{"enough_20", type logical}
					}),
				Result = Typed
			in
				Result
