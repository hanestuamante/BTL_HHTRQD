table Sensitivity
	lineageTag: c52c4c16-93ce-47d1-a633-cc624ed50ac6

	column 'Ngưỡng (%)'
		dataType: int64
		summarizeBy: sum
		sourceColumn: threshold_pct
		lineageTag: e0c164b9-b147-48ac-83be-b787a90e23c8
	column 'Số ứng viên'
		dataType: int64
		summarizeBy: sum
		sourceColumn: candidates
		lineageTag: 6fbc08c4-f399-4c52-999f-ec2e64e68204
	column 'Tỷ lệ (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: 3a23c74f-7129-4170-8071-ea32700a80e5
	column 'all3'
		dataType: int64
		summarizeBy: sum
		sourceColumn: all3
		lineageTag: 7d35cd3b-8d5f-4292-ba6b-12b07c0af7ac
	column 'over_50pct'
		dataType: int64
		summarizeBy: sum
		sourceColumn: over_50pct
		lineageTag: 20503efa-1307-4f4f-a21d-ad2273f8e564
	column 'Giá trung vị (USD)'
		dataType: double
		summarizeBy: sum
		sourceColumn: median_price
		lineageTag: 015dc420-41dd-4312-9bf8-300d45ebf04d
	column 'enough_20'
		dataType: boolean
		sourceColumn: enough_20
		lineageTag: d41f169c-78b6-4211-9601-6d37d32734a3

	partition Sensitivity = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\sensitivity.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"threshold_pct", Int64.Type},
					{"candidates", Int64.Type},
					{"share_pct", type number},
					{"all3", Int64.Type},
					{"over_50pct", Int64.Type},
					{"median_price", type number},
					{"enough_20", type logical}
					}),
				Result = Typed
			in
				Result
