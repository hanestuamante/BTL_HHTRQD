table Sensitivity
	lineageTag: 2a59a804-c4f5-4778-9be5-81f167eff0b7

	column 'Ngưỡng (%)'
		dataType: int64
		summarizeBy: sum
		sourceColumn: threshold_pct
		lineageTag: 379e7577-6155-46be-ac5a-56a87be4ac65
	column 'Số ứng viên'
		dataType: int64
		summarizeBy: sum
		sourceColumn: candidates
		lineageTag: e862c2c3-a0fe-4c39-bdf0-3fa5451626d8
	column 'Tỷ lệ (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: 912d2c92-15b5-4c68-a414-cd5f52a4bf5f
	column 'all3'
		dataType: int64
		summarizeBy: sum
		sourceColumn: all3
		lineageTag: 7fd7be99-6e55-4dfa-b777-223d41a583dd
	column 'over_50pct'
		dataType: int64
		summarizeBy: sum
		sourceColumn: over_50pct
		lineageTag: 6a17f451-e4ea-4036-8875-d9ec33df7a29
	column 'Giá trung vị (USD)'
		dataType: double
		summarizeBy: sum
		sourceColumn: median_price
		lineageTag: d353391d-8b2e-4ba6-99a4-c2e8f7be77ed
	column 'enough_20'
		dataType: boolean
		sourceColumn: enough_20
		lineageTag: f4a9d7d7-85fc-4098-beba-7815cc1e2b7d

	partition Sensitivity = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\sensitivity.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"threshold_pct", Int64.Type},
					{"candidates", Int64.Type},
					{"share_pct", type number},
					{"all3", Int64.Type},
					{"over_50pct", Int64.Type},
					{"median_price", type number},
					{"enough_20", type logical}
					}),
				Result = Typed
			in
				Result
