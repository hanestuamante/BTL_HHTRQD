table Sensitivity
	lineageTag: b3df8f1a-28c2-4e67-9a5d-4750acdc8803

	column threshold_pct
		dataType: int64
		summarizeBy: sum
		sourceColumn: threshold_pct
		lineageTag: 246bd7d1-9325-4f3c-837f-9a6d8139726b
	column candidates
		dataType: int64
		summarizeBy: sum
		sourceColumn: candidates
		lineageTag: 8934be34-2cc6-4cf1-a558-f5d17ea3cded
	column share_pct
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: 8a154162-7e2c-4aa0-9d5e-5a43ef5c6df1
	column all3
		dataType: int64
		summarizeBy: sum
		sourceColumn: all3
		lineageTag: bb9ce8d2-a015-4adf-888b-5b97eede9974
	column over_50pct
		dataType: int64
		summarizeBy: sum
		sourceColumn: over_50pct
		lineageTag: 13111c25-f839-4daa-8e4a-2726993b4c30
	column median_price
		dataType: double
		summarizeBy: sum
		sourceColumn: median_price
		lineageTag: d80c5da1-ac63-41a8-8c79-434c5d3ec6f2
	column enough_20
		dataType: boolean
		sourceColumn: enough_20
		lineageTag: 7d294143-d210-40ab-a5e8-7e9a60ed68bc

	partition Sensitivity = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\sensitivity.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"threshold_pct", Int64.Type},
					{"candidates", Int64.Type},
					{"share_pct", type number},
					{"all3", Int64.Type},
					{"over_50pct", Int64.Type},
					{"median_price", type number},
					{"enough_20", type logical}
					}),
				Result = Typed
			in
				Result
