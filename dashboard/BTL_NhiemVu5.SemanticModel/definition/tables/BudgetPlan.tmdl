table BudgetPlan
	lineageTag: 691f5b47-3550-4e37-8831-5a442c66701f

	column 'Hạng'
		dataType: int64
		summarizeBy: sum
		sourceColumn: rank
		lineageTag: 84ecd66d-c028-4ab6-baee-53dd14a9fc78
	column 'Giá bán'
		dataType: double
		summarizeBy: sum
		sourceColumn: price
		lineageTag: f1466b3b-d434-4541-81ab-51d46549c3ef
	column 'Lũy kế (USD)'
		dataType: double
		summarizeBy: sum
		sourceColumn: cum_price
		lineageTag: 0b38e139-50e4-454b-91b9-aefac0c29c20
	column 'Chênh lệch (USD)'
		dataType: double
		summarizeBy: sum
		sourceColumn: upside_usd
		lineageTag: 06169c70-a604-4ab1-ae4c-4f27c0f62a3a

	partition BudgetPlan = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\budget_plan.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"rank", Int64.Type},
					{"price", type number},
					{"cum_price", type number},
					{"upside_usd", type number}
					}),
				Result = Typed
			in
				Result
