table BudgetPlan
	lineageTag: 6bd67480-7179-4a0e-9d23-f632cf1509e8

	column 'Hạng'
		dataType: int64
		summarizeBy: sum
		sourceColumn: rank
		lineageTag: 6a5dea04-d2a0-4b4d-bf91-4b5624256114
	column 'Giá bán'
		dataType: double
		summarizeBy: sum
		sourceColumn: price
		lineageTag: 51f1f71d-07b9-4b99-a8a1-db809a414439
	column 'Lũy kế (USD)'
		dataType: double
		summarizeBy: sum
		sourceColumn: cum_price
		lineageTag: 296a16d9-a79d-4ed0-84f1-1a7e1cd1442c
	column 'Chênh lệch (USD)'
		dataType: double
		summarizeBy: sum
		sourceColumn: upside_usd
		lineageTag: 7f5d9296-e6de-4fc5-8213-2f3954660faa

	partition BudgetPlan = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\budget_plan.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"rank", Int64.Type},
					{"price", type number},
					{"cum_price", type number},
					{"upside_usd", type number}
					}),
				Result = Typed
			in
				Result
