table BudgetPlan
	lineageTag: 0c22d466-35a3-4876-ab5e-5ecbe7193987

	column 'Hạng'
		dataType: int64
		summarizeBy: sum
		sourceColumn: rank
		lineageTag: 903f4f47-446a-4f57-b24e-3cd7b83aaf18
	column 'Giá bán'
		dataType: double
		summarizeBy: sum
		sourceColumn: price
		lineageTag: 8d63d371-919c-45d8-930b-94abbd3ff6f8
	column 'Lũy kế (USD)'
		dataType: double
		summarizeBy: sum
		sourceColumn: cum_price
		lineageTag: 4e26ebe1-a095-4458-bcb6-0c820647a9ae
	column 'Chênh lệch (USD)'
		dataType: double
		summarizeBy: sum
		sourceColumn: upside_usd
		lineageTag: 73e15da0-438b-41ba-a903-99de4fb7cdf2

	partition BudgetPlan = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\budget_plan.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"rank", Int64.Type},
					{"price", type number},
					{"cum_price", type number},
					{"upside_usd", type number}
					}),
				Result = Typed
			in
				Result
