table Stability
	lineageTag: 2a7312da-5405-4bc6-af69-086cfce30893

	column 'Kịch bản'
		dataType: string
		sourceColumn: variant
		lineageTag: 6fdecf91-efd9-4cb3-96f8-5cf904bf5f86
	column 'Trùng 20 căn'
		dataType: int64
		summarizeBy: sum
		sourceColumn: overlap_20
		lineageTag: cd966441-6877-442d-863e-f311831fe674
	column 'Tỷ lệ (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: 6a8965ef-f710-4b98-b9b1-b2b75699ecf0

	partition Stability = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\stability.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"variant", type text},
					{"overlap_20", Int64.Type},
					{"share_pct", type number}
					}),
				Result = Typed
			in
				Result
