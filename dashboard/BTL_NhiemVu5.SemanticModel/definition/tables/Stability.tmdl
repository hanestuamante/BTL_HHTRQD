table Stability
	lineageTag: 213e9d45-b81f-4a47-9787-118da9ff4555

	column variant
		dataType: string
		sourceColumn: variant
		lineageTag: 5fe02f90-5f47-452b-98ea-4c9e3e509d7b
	column overlap_20
		dataType: int64
		summarizeBy: sum
		sourceColumn: overlap_20
		lineageTag: 534e1e98-cebe-4d38-a6c7-d9652bee9d99
	column share_pct
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: d0d6b57f-818a-4293-a787-dff964f52f1a

	partition Stability = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\stability.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"variant", type text},
					{"overlap_20", Int64.Type},
					{"share_pct", type number}
					}),
				Result = Typed
			in
				Result
