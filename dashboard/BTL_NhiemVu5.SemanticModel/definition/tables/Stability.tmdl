table Stability
	lineageTag: fd945895-17e7-4cae-bfdf-3374d655ce76

	column 'Kịch bản'
		dataType: string
		sourceColumn: variant
		lineageTag: 57fd2363-86e3-4415-a6c9-ad9a98277924
	column 'Trùng 20 căn'
		dataType: int64
		summarizeBy: sum
		sourceColumn: overlap_20
		lineageTag: f55486b1-1f7d-4d47-8a2c-55d09942c11f
	column 'Tỷ lệ (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: 6ed21ad3-1d29-4eeb-a1ca-ee3515633061

	partition Stability = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\stability.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"variant", type text},
					{"overlap_20", Int64.Type},
					{"share_pct", type number}
					}),
				Result = Typed
			in
				Result
