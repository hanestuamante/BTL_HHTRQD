table Stability
	lineageTag: 475d10ec-031a-4409-bbc8-6c4eba486ae3

	column 'Kịch bản'
		dataType: string
		sourceColumn: variant
		lineageTag: c8091d9b-6bce-4bce-824f-05bf7bca8906
	column 'Trùng 20 căn'
		dataType: int64
		summarizeBy: sum
		sourceColumn: overlap_20
		lineageTag: 5aa80939-9da0-46fc-a28a-4ee1af0c4572
	column 'Tỷ lệ (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: 1c9e798d-ef7c-40f8-ab1e-c4bb7e3151d2

	partition Stability = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\stability.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"variant", type text},
					{"overlap_20", Int64.Type},
					{"share_pct", type number}
					}),
				Result = Typed
			in
				Result
