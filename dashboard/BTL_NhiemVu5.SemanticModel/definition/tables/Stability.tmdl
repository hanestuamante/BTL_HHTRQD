table Stability
	lineageTag: c50d0ba5-fc6b-4edf-bd57-3645b5396ce2

	column variant
		dataType: string
		sourceColumn: variant
		lineageTag: 1a50c6ee-ce79-4ea8-9ef5-0ef4bb298f12
	column overlap_20
		dataType: int64
		summarizeBy: sum
		sourceColumn: overlap_20
		lineageTag: e9fdf557-cdd4-4693-93eb-01dac677a51e
	column share_pct
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: 4a4fb37a-5673-44af-a423-48d9beb098a9

	partition Stability = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\stability.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"variant", type text},
					{"overlap_20", Int64.Type},
					{"share_pct", type number}
					}),
				Result = Typed
			in
				Result
