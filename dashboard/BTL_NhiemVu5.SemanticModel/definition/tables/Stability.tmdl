table Stability
	lineageTag: 274de774-3310-42a5-8bef-079019b41fdb

	column 'Kịch bản'
		dataType: string
		sourceColumn: variant
		lineageTag: c76f5850-4321-4fe6-8de8-4d4d652a40bf
	column 'Trùng 20 căn'
		dataType: int64
		summarizeBy: sum
		sourceColumn: overlap_20
		lineageTag: b9105e40-2106-4ca1-91c6-ac4c1768e8eb
	column 'Tỷ lệ (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: share_pct
		lineageTag: ef79b0bb-7741-4a51-98f7-54eddea18cfc

	partition Stability = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\stability.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"variant", type text},
					{"overlap_20", Int64.Type},
					{"share_pct", type number}
					}),
				Result = Typed
			in
				Result
