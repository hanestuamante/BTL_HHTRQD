table WhatIfScenarios
	lineageTag: b44fb5ce-1502-4a2b-bd3a-75478245c766

	column 'Kịch bản'
		dataType: string
		sourceColumn: scenario
		lineageTag: 2c33c10f-4443-442d-9fed-6138c922429e
	column 'Thay đổi (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: median_change_pct
		lineageTag: ba6119f3-9313-4986-b003-10e1b6f3a8a6
	column 'mean_change_pct'
		dataType: double
		summarizeBy: sum
		sourceColumn: mean_change_pct
		lineageTag: 21f96d42-1e69-4080-b9d0-9da85fcbaa6d
	column 'p10'
		dataType: double
		summarizeBy: sum
		sourceColumn: p10
		lineageTag: 483a77fb-b8ac-4e17-8109-c56f81dbdd46
	column 'p90'
		dataType: double
		summarizeBy: sum
		sourceColumn: p90
		lineageTag: 74dad855-be9f-485e-bded-e54e6bb37775

	partition WhatIfScenarios = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\whatif_scenarios.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"scenario", type text},
					{"median_change_pct", type number},
					{"mean_change_pct", type number},
					{"p10", type number},
					{"p90", type number}
					}),
				Result = Typed
			in
				Result
