table WhatIfScenarios
	lineageTag: a187c855-1c06-4b72-9bbb-d0c27db22003

	column 'Kịch bản'
		dataType: string
		sourceColumn: scenario
		lineageTag: e38370c8-e6ad-4a92-b5d1-1257ffa82055
	column 'Thay đổi (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: median_change_pct
		lineageTag: f500fbc6-ae82-4c75-a772-5e643f2fe98b
	column 'mean_change_pct'
		dataType: double
		summarizeBy: sum
		sourceColumn: mean_change_pct
		lineageTag: dce23eec-1bb4-4ed7-9e7d-cbcb978c0cfb
	column 'p10'
		dataType: double
		summarizeBy: sum
		sourceColumn: p10
		lineageTag: 5886519b-561c-450a-b20d-27d499b52556
	column 'p90'
		dataType: double
		summarizeBy: sum
		sourceColumn: p90
		lineageTag: d58751f1-3c7f-4997-8b7c-9b785df99ac1

	partition WhatIfScenarios = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\whatif_scenarios.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"scenario", type text},
					{"median_change_pct", type number},
					{"mean_change_pct", type number},
					{"p10", type number},
					{"p90", type number}
					}),
				Result = Typed
			in
				Result
