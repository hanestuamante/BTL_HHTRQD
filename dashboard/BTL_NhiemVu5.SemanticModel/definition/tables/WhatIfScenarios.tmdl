table WhatIfScenarios
	lineageTag: 61d14b6e-1d4c-4cee-ab05-6aa5ea2145ae

	column scenario
		dataType: string
		sourceColumn: scenario
		lineageTag: c06d99bb-1cf9-49f4-a18f-7d62f0c0f79b
	column median_change_pct
		dataType: double
		summarizeBy: sum
		sourceColumn: median_change_pct
		lineageTag: dc9fb5ea-0bda-4027-9626-4f25c099edc0
	column mean_change_pct
		dataType: double
		summarizeBy: sum
		sourceColumn: mean_change_pct
		lineageTag: b001baac-fdf1-42e2-ab07-d00e995228df
	column p10
		dataType: double
		summarizeBy: sum
		sourceColumn: p10
		lineageTag: 494ec6ab-6c64-46f8-8b83-1a84efa42d67
	column p90
		dataType: double
		summarizeBy: sum
		sourceColumn: p90
		lineageTag: 80d0c912-a143-4cf2-9a2f-c750ce0b5127

	partition WhatIfScenarios = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\whatif_scenarios.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"scenario", type text},
					{"median_change_pct", type number},
					{"mean_change_pct", type number},
					{"p10", type number},
					{"p90", type number}
					}),
				Result = Typed
			in
				Result
