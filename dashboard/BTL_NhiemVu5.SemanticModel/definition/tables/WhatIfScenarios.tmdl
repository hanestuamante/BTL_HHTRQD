table WhatIfScenarios
	lineageTag: a67368da-4d1b-4ce6-afbf-2a73597c0994

	column scenario
		dataType: string
		sourceColumn: scenario
		lineageTag: 275b8fa6-ad28-46c9-917d-88629d0dcd7d
	column median_change_pct
		dataType: double
		summarizeBy: sum
