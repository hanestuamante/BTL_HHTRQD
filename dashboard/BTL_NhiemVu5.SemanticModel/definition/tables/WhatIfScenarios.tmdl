table WhatIfScenarios
	lineageTag: 66d37309-2ae5-4fc8-96d6-d89cb81b78a0

	column scenario
		dataType: string
		sourceColumn: scenario
		lineageTag: 77c65591-a992-4f1a-be60-cab2f56fecb9
	column median_change_pct
		dataType: double
		summarizeBy: sum
		sourceColumn: median_change_pct
		lineageTag: 865ef8ca-bed9-4170-8211-dacdb35486f9
	column mean_change_pct
		dataType: double
		summarizeBy: sum
		sourceColumn: mean_change_pct
		lineageTag: 3c68d15f-1b0a-4ccf-befa-1c4de74331de
	column p10
		dataType: double
		summarizeBy: sum
		sourceColumn: p10
		lineageTag: 9ce2957d-4395-4936-b183-9c3f76f3ee26
	column p90
		dataType: double
		summarizeBy: sum
		sourceColumn: p90
		lineageTag: 5fd89bc2-8917-4a83-b9e4-493ca38a5401

	partition WhatIfScenarios = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\whatif_scenarios.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"scenario", type text},
					{"median_change_pct", type number},
					{"mean_change_pct", type number},
					{"p10", type number},
					{"p90", type number}
					}),
				Result = Typed
			in
				Result
