table WhatIfScenarios
	lineageTag: 2b00699e-d5b9-46da-8535-a4383fe6642e

	column 'Kịch bản'
		dataType: string
		sourceColumn: scenario
		lineageTag: 485f9414-12b7-44ea-bbf7-4079e36b5589
	column 'Thay đổi (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: median_change_pct
		lineageTag: 1785b2e3-2074-4c3a-b05a-10683a07bad5
	column 'mean_change_pct'
		dataType: double
		summarizeBy: sum
		sourceColumn: mean_change_pct
		lineageTag: 4cc7fc56-56f9-49d3-8701-80f85df207e9
	column 'p10'
		dataType: double
		summarizeBy: sum
		sourceColumn: p10
		lineageTag: 78d11c99-fd2a-4a04-a1b8-044a2bd8eeab
	column 'p90'
		dataType: double
		summarizeBy: sum
		sourceColumn: p90
		lineageTag: a146fa4c-1f4f-4eea-ab4d-1f81e8aa7fd0

	partition WhatIfScenarios = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\whatif_scenarios.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"scenario", type text},
					{"median_change_pct", type number},
					{"mean_change_pct", type number},
					{"p10", type number},
					{"p90", type number}
					}),
				Result = Typed
			in
				Result
