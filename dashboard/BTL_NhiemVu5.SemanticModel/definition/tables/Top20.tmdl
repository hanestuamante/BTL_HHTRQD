	partition Top20 = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\top20.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"Hang", Int64.Type},
					{"id", type text},
					{"date", type date},
					{"zipcode", type text},
					{"price", type number},
					{"predicted_price", type number},
					{"upside_usd", type number},
					{"discount_pct", type number},
					{"discount_conservative_pct", type number},
					{"residual", type number},
					{"models_agree_undervalued", Int64.Type},
					{"sqft_living", type number},
					{"bedrooms", type number},
					{"bathrooms", type number},
					{"grade", type number},
					{"condition", type number},
					{"view", type number},
					{"waterfront", type number},
					{"house_age", type number},
					{"distance_to_center_km", type number},
					{"lat", type number},
					{"long", type number},
					{"cumulative_cost_usd", type number},
					{"price_band", type text}
					}),
				Result = Typed
			in
				Result
