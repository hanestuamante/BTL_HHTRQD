	partition Top20 = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\top20.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"Hang", Int64.Type},
					{"id", type text},
					{"date", type date},
					{"zipcode", type text},
					{"price", type number},
					{"predicted_price", type number},
					{"upside_usd", type number},
					{"discount_pct", type number},
					{"discount_conservative_pct", type number},
					{"residual", type number},
					{"models_agree_undervalued", Int64.Type},
					{"sqft_living", Int64.Type},
					{"bedrooms", Int64.Type},
					{"bathrooms", type number},
					{"grade", Int64.Type},
					{"condition", Int64.Type},
					{"view", Int64.Type},
					{"waterfront", Int64.Type},
					{"house_age", Int64.Type},
					{"distance_to_center_km", type number},
					{"lat", type number},
					{"long", type number},
					{"cumulative_cost_usd", type number},
					{"price_band", type text}
					}),
				Result = Typed
			in
				Result
