table KPI
	lineageTag: 028b2657-0302-4466-9446-b8c3d6048414

	measure 'King Transactions' =
			COUNTROWS('KingSales')
		formatString: #,0
		lineageTag: afc79a87-861e-4516-bc78-3c787d20d93f

	measure 'King Properties' =
			DISTINCTCOUNT('KingSales'[id])
		formatString: #,0
		lineageTag: c4505407-9ea7-4676-a6c8-12b021a7c219

	measure 'King Median Price' =
			MEDIAN('KingSales'[price])
		formatString: #,0
		lineageTag: bcc0a3e2-1997-4d2c-8d3c-ee3eac522ac5

	measure 'King OOF MAPE' =
			AVERAGEX('KingSales', ABS('KingSales'[residual_pct]))
		formatString: 0.0%
		lineageTag: 9fa66814-d2f3-4468-a43b-f5f779e84146

	measure 'Selected Threshold' =
			IF(ISFILTERED('Nguong'[Value]), MIN('Nguong'[Value]), 0.20)
		formatString: 0%
		lineageTag: 42f47fac-db4b-466f-b3d6-7c67b3dbbafc

	measure 'Candidate Base' =
			CALCULATE(COUNTROWS('KingSales'), 'KingSales'[is_latest_sale] = 1, 'KingSales'[zero_room_flag] = 0, 'KingSales'[condition] >= 3)
		formatString: #,0
		lineageTag: fc85a3c8-6c74-4068-8d35-5779198b423f

	measure 'Candidates' =
			VAR t = -[Selected Threshold]
			RETURN CALCULATE([Candidate Base], 'KingSales'[residual_pct] <= t)
		formatString: #,0
		lineageTag: a48e8d5f-036e-4f66-b481-6614e266c79d

	measure 'Candidate Share' =
			DIVIDE([Candidates], [Candidate Base])
		formatString: 0.00%
		lineageTag: 6ef6ccf0-75c9-41f9-9165-7000c905ced5

	measure 'Candidate Upside' =
			VAR t = -[Selected Threshold]
			RETURN CALCULATE(SUM('KingSales'[upside_usd]), 'KingSales'[is_latest_sale] = 1, 'KingSales'[zero_room_flag] = 0, 'KingSales'[condition] >= 3, 'KingSales'[residual_pct] <= t)
		formatString: #,0
		lineageTag: f8eb5626-ca72-4943-81bc-807fe541c457

	measure 'Candidate Median Price' =
			VAR t = -[Selected Threshold]
			RETURN CALCULATE(MEDIAN('KingSales'[price]), 'KingSales'[is_latest_sale] = 1, 'KingSales'[zero_room_flag] = 0, 'KingSales'[condition] >= 3, 'KingSales'[residual_pct] <= t)
		formatString: #,0
		lineageTag: 33304e79-7bcc-458a-b51b-a545fcee6ead

	measure 'Candidate All3' =
			VAR t = -[Selected Threshold]
			RETURN CALCULATE(COUNTROWS('KingSales'), 'KingSales'[is_latest_sale] = 1, 'KingSales'[zero_room_flag] = 0, 'KingSales'[condition] >= 3, 'KingSales'[models_agree_undervalued] = 3, 'KingSales'[residual_pct] <= t)
		formatString: #,0
		lineageTag: d62ff026-740c-4c63-8cb9-10a23b424ed6

	measure 'Top20 Count' =
			COUNTROWS('Top20')
		formatString: #,0
		lineageTag: 765710b3-c74c-4a3a-b55e-51daa4d513b3

	measure 'Top20 Capital' =
			SUM('Top20'[price])
		formatString: #,0
		lineageTag: 728d94f5-6b40-4a26-8f89-40ac9020b05a

	measure 'Top20 Upside' =
			SUM('Top20'[upside_usd])
		formatString: #,0
		lineageTag: 7260608d-1c00-47a5-b930-cd412f217e86

	measure 'Top20 Median Discount' =
			MEDIAN('Top20'[discount_pct])
		formatString: 0.0
		lineageTag: 79be2f55-f450-4e8b-b117-64a99902af80

	measure 'Top20 All3' =
			COUNTROWS(FILTER('Top20', 'Top20'[models_agree_undervalued] = 3))
		formatString: #,0
		lineageTag: 0c9c5fea-60a5-4d7f-b0e7-6e8ba6f21815

	measure 'Importance Increase' =
			SUM('ImportanceTop'[mape_increase_pp])
		formatString: 0.00
		lineageTag: 3bb3a1e4-88e8-437c-baee-2edf1ee163c8

	measure 'Scenario Change' =
			SUM('WhatIfScenarios'[median_change_pct])
		formatString: 0.00
		lineageTag: 6194733f-35da-4cf3-8fe4-212acaaf2356

	measure 'Sensitivity Candidates' =
			SUM('Sensitivity'[candidates])
		formatString: #,0
		lineageTag: 7b8c1d87-84b8-422e-a5d3-5fdc8e92e7e1

	measure 'Model MAPE' =
			SUM('ModelCompare'[mape])
		formatString: 0.0
		lineageTag: 8cb166c2-cc2f-4b56-b5bb-13a8b373c128

	measure 'KingTx Text' =
			FORMAT([King Transactions], "#,##0")
		lineageTag: 28bfd796-2176-499b-93e7-bd68585e01c1

	measure 'KingMedian Text' =
			FORMAT([King Median Price], "#,##0")
		lineageTag: 8aec9bac-e983-4a5a-bfa9-15c650d77d7b

	measure 'Candidates Text' =
			FORMAT([Candidates], "#,##0")
		lineageTag: d53b9070-3790-4136-9347-4ccc57502ea3

	measure 'CandidateUpside Text' =
			FORMAT([Candidate Upside], "#,##0")
		lineageTag: 85a8bfc0-d14e-40a0-86a9-13bbcdfddf28

	measure 'CandidateMedian Text' =
			FORMAT([Candidate Median Price], "#,##0")
		lineageTag: 47af9572-837d-4d4d-9dd0-af61cd95d9ee

	measure 'Top20Capital Text' =
			FORMAT([Top20 Capital], "#,##0")
		lineageTag: e75d3269-20aa-4197-99fc-39536bcf7404

	measure 'Top20Upside Text' =
			FORMAT([Top20 Upside], "#,##0")
		lineageTag: 27fc5b5a-9376-4601-8cc4-8e07c8ea49e9

	measure 'Top20All3 Text' =
			FORMAT([Top20 All3], "#,##0")
		lineageTag: fe8b2540-3342-45bc-874c-7dfc31ef2280

	measure 'AmesProperties Text' =
			FORMAT([Ames Properties], "#,##0")
		lineageTag: 999ce546-f715-4b6b-838a-1a4894ebac03

	measure 'AmesMedian Text' =
			FORMAT([Ames Median Price], "#,##0")
		lineageTag: 2cc19301-e748-4c95-973a-dfe65a6451e6

	measure 'AmesCandidates Text' =
			FORMAT([Ames Candidates], "#,##0")
		lineageTag: 373212c3-3fcb-4760-abf8-125a039a8bd6

	measure 'Ames Properties' =
			COUNTROWS('AmesSales')
		formatString: #,0
		lineageTag: 5aeb9cfa-dffb-4dc0-8b72-570961d1f07e

	measure 'Ames Median Price' =
			MEDIAN('AmesSales'[price])
		formatString: #,0
		lineageTag: 2b15ec6f-790f-455b-b564-d9f5e92dfa51

	measure 'Ames OOF MAPE' =
			AVERAGEX('AmesSales', ABS('AmesSales'[residual_pct]))
		formatString: 0.0%
		lineageTag: 4a6b4526-d355-4e57-ad3e-f31c06e56c28

	measure 'Ames Candidates' =
			VAR t = -[Selected Threshold]
			RETURN CALCULATE(COUNTROWS('AmesSales'), 'AmesSales'[residual_pct] <= t)
		formatString: #,0
		lineageTag: e8335555-949e-43f0-825e-c9f86ae082bb

	measure 'Ames Candidate Share' =
			DIVIDE([Ames Candidates], [Ames Properties])
		formatString: 0.00%
		lineageTag: 44acff27-424e-4175-98a1-ae7088a4eb6b

	measure 'MAPE King XGB' =
			CALCULATE(MAX('ModelMetrics'[mape]), 'ModelMetrics'[market] = "King County", 'ModelMetrics'[model] = "XGBoost (tuned)")
		formatString: 0.0
		lineageTag: 0b9b0ca7-b3a1-48f4-93b1-947e05b127f1

	measure 'MAPE Ames XGB' =
			CALCULATE(MAX('ModelMetrics'[mape]), 'ModelMetrics'[market] = "Ames", 'ModelMetrics'[model] = "XGBoost")
		formatString: 0.0
		lineageTag: 1291b237-6c4e-4746-91a9-be5b4b918c48

	measure 'R2 King XGB' =
			CALCULATE(MAX('ModelMetrics'[r2]), 'ModelMetrics'[market] = "King County", 'ModelMetrics'[model] = "XGBoost (tuned)")
		formatString: 0.000
		lineageTag: dc26cb2d-0e8e-49e9-987e-c01e28dc9d6b

	measure 'R2 Ames XGB' =
			CALCULATE(MAX('ModelMetrics'[r2]), 'ModelMetrics'[market] = "Ames", 'ModelMetrics'[model] = "XGBoost")
		formatString: 0.000
		lineageTag: af1c9a29-4864-4e45-bf18-50adbb464f98

	measure 'MAPE King Time XGB' =
			CALCULATE(MAX('ModelMetrics'[mape]), 'ModelMetrics'[market] = "King County (chia theo thời gian)", 'ModelMetrics'[model] = "XGBoost (tuned)")
		formatString: 0.0
		lineageTag: 4e038731-fb96-4a3d-b603-6f01053009cf

	column Placeholder
