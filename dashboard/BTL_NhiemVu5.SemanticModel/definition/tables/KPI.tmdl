table KPI
	lineageTag: 90ebe975-ebd5-4e98-ab75-b92ec4f12abe

	measure 'Số giao dịch' =
			COUNTROWS('KingSales')
		formatString: #,0
		lineageTag: 7817da7e-3598-4939-b6c1-86763185a618

	measure 'King Properties' =
			DISTINCTCOUNT('KingSales'[Mã căn])
		formatString: #,0
		lineageTag: ad90be34-56b4-45c6-8f45-bc72fcd412d5

	measure 'Giá trung vị' =
			MEDIAN('KingSales'[Giá bán])
		formatString: #,0
		lineageTag: a2b77acc-5b30-442a-8929-c8a75184d1e9

	measure 'King OOF MAPE' =
			AVERAGEX('KingSales', ABS('KingSales'[Sai số (%)]))
		formatString: 0.0%
		lineageTag: 0665dd60-73ba-4f52-8ea6-4af62afbbf14

	measure 'Ngưỡng (%)' =
			VAR p = IF(ISFILTERED('Nguong'[Value]), MIN('Nguong'[Value]), 20)
			RETURN p / 100
		formatString: 0%
		lineageTag: e06c61ef-6e00-44a3-a8f5-c92fcc554b34

	measure 'Candidate Base' =
			CALCULATE(COUNTROWS('KingSales'), 'KingSales'[Giao dịch mới nhất] = 1, 'KingSales'[Thiếu phòng] = 0, 'KingSales'[Tình trạng] >= 3)
		formatString: #,0
		lineageTag: 1fba296c-f7a5-4d1a-b234-52513a7d8a3c

	measure 'Số ứng viên' =
			VAR t = -[Ngưỡng (%)]
			RETURN CALCULATE([Candidate Base], 'KingSales'[Sai số (%)] <= t)
		formatString: #,0
		lineageTag: 9bc21bb0-d182-4458-821a-9787c08eb5cd

	measure 'Tỷ lệ ứng viên' =
			DIVIDE([Số ứng viên], [Candidate Base])
		formatString: 0.00%
		lineageTag: 45741a19-eaf2-45d0-8e25-6afa7128a945

	measure 'Chênh lệch ứng viên (USD)' =
			VAR t = -[Ngưỡng (%)]
			RETURN CALCULATE(SUM('KingSales'[Chênh lệch (USD)]), 'KingSales'[Giao dịch mới nhất] = 1, 'KingSales'[Thiếu phòng] = 0, 'KingSales'[Tình trạng] >= 3, 'KingSales'[Sai số (%)] <= t)
		formatString: #,0
		lineageTag: 5377bd29-7da6-4b26-bce3-e8f656006c36

	measure 'Giá trung vị ứng viên' =
			VAR t = -[Ngưỡng (%)]
			RETURN CALCULATE(MEDIAN('KingSales'[Giá bán]), 'KingSales'[Giao dịch mới nhất] = 1, 'KingSales'[Thiếu phòng] = 0, 'KingSales'[Tình trạng] >= 3, 'KingSales'[Sai số (%)] <= t)
		formatString: #,0
		lineageTag: 86acac0b-ef5e-41a4-b292-8a3a7db1eb9e

	measure 'Đồng thuận 3 mô hình' =
			VAR t = -[Ngưỡng (%)]
			RETURN CALCULATE(COUNTROWS('KingSales'), 'KingSales'[Giao dịch mới nhất] = 1, 'KingSales'[Thiếu phòng] = 0, 'KingSales'[Tình trạng] >= 3, 'KingSales'[Số mô hình đồng ý] = 3, 'KingSales'[Sai số (%)] <= t)
		formatString: #,0
		lineageTag: 0f07e95a-5f35-4707-8783-b7e41ca260c9

	measure 'Top20 Count' =
			COUNTROWS('Top20')
		formatString: #,0
		lineageTag: 09b13056-65d3-47c1-823a-0e1ddc1a6357

	measure 'Vốn Top20 (USD)' =
			SUM('Top20'[Giá bán])
		formatString: #,0
		lineageTag: 4f49608c-aa51-46f4-a0be-e3934cba87d3

	measure 'Chênh lệch Top20 (USD)' =
			SUM('Top20'[Chênh lệch (USD)])
		formatString: #,0
		lineageTag: 40afa8dc-7df7-4efa-9ffa-7fee183adb34

	measure 'Mức giảm trung vị (%)' =
			MEDIAN('Top20'[Mức giảm (%)])
		formatString: 0.0"%"
		lineageTag: 4206330a-664c-4cf6-9880-69b8717fd692

	measure 'Top20 All3' =
			COUNTROWS(FILTER('Top20', 'Top20'[Số mô hình đồng ý] = 3))
		formatString: #,0
		lineageTag: bb1ae061-9f4d-44e9-a855-0380e3a4e615

	measure 'MAPE tăng (điểm %)' =
			SUM('ImportanceTop'[MAPE tăng (điểm %)])
		formatString: 0.00
		lineageTag: d94b367e-8638-4bf2-93b1-a55e002f852a

	measure 'Thay đổi giá (%)' =
			SUM('WhatIfScenarios'[Thay đổi (%)])
		formatString: 0.00
		lineageTag: 4876c5d6-3f4c-4cd7-9813-f3047f00fb69

	measure 'Số ứng viên theo ngưỡng' =
			SUM('Sensitivity'[Số ứng viên])
		formatString: #,0
		lineageTag: 42a10eb2-1282-4987-88e0-13278e48d5ec

	measure 'MAPE (%)' =
			SUM('ModelCompare'[MAPE (%)])
		formatString: 0.0
		lineageTag: 8e3929cf-3089-4435-8649-33b6064dc992

	measure 'KingTx Text' =
			FORMAT([Số giao dịch], "#,##0")
		lineageTag: 1e769e70-f9b2-466e-add3-8b1fe4cb3567

	measure 'KingMedian Text' =
			FORMAT([Giá trung vị], "#,##0")
		lineageTag: 33889f90-afbd-4358-b0e3-dbf24b7fd97a

	measure 'Candidates Text' =
			FORMAT([Số ứng viên], "#,##0")
		lineageTag: 40b5caa9-5c13-4f58-83a3-ccce2f2f6309

	measure 'CandidateUpside Text' =
			FORMAT([Chênh lệch ứng viên (USD)], "#,##0")
		lineageTag: 470be0f7-9c39-4165-90a2-6643d346c64f

	measure 'CandidateMedian Text' =
			FORMAT([Giá trung vị ứng viên], "#,##0")
		lineageTag: 8946be73-96ff-4eef-9d7c-3b3e957d6df2

	measure 'Top20Capital Text' =
			FORMAT([Vốn Top20 (USD)], "#,##0")
		lineageTag: b0d6a0bb-65eb-4d5a-b2b9-e209211e1397

	measure 'Top20Upside Text' =
			FORMAT([Chênh lệch Top20 (USD)], "#,##0")
		lineageTag: 58e3b042-69f3-41fe-9a46-7b4287466ff2

	measure 'Top20All3 Text' =
			FORMAT([Top20 All3], "#,##0")
		lineageTag: 9bccb173-d87d-4c09-98fc-d64b8e702e00

	measure 'AmesProperties Text' =
			FORMAT([Số tài sản Ames], "#,##0")
		lineageTag: 0a118241-e283-4562-aac2-df0d49d2f100

	measure 'AmesMedian Text' =
			FORMAT([Giá trung vị Ames], "#,##0")
		lineageTag: c0c3461b-0f45-4507-a793-074220e2a30d

	measure 'AmesCandidates Text' =
			FORMAT([Số ứng viên Ames], "#,##0")
		lineageTag: 6177d48a-d80f-42c5-8d7e-ce408bbf121d

	measure 'Số tài sản Ames' =
			COUNTROWS('AmesSales')
		formatString: #,0
		lineageTag: 86a4cd8e-8d11-441f-995f-d002c0ba4a57

	measure 'Giá trung vị Ames' =
			MEDIAN('AmesSales'[Giá bán])
		formatString: #,0
		lineageTag: 552826a2-83da-4353-bb03-74be7d59213f

	measure 'Ames OOF MAPE' =
			AVERAGEX('AmesSales', ABS('AmesSales'[Sai số (%)]))
		formatString: 0.0%
		lineageTag: e4434fb1-b4a5-4bfc-993e-94ed2213b2ea

	measure 'Số ứng viên Ames' =
			VAR t = -[Ngưỡng (%)]
			RETURN CALCULATE(COUNTROWS('AmesSales'), 'AmesSales'[Sai số (%)] <= t)
		formatString: #,0
		lineageTag: 25ceac72-c8d0-4ed2-9559-de2ef1d1f739

	measure 'Ames Candidate Share' =
			DIVIDE([Số ứng viên Ames], [Số tài sản Ames])
		formatString: 0.00%
		lineageTag: cf25ba27-dee6-4fd6-b0c8-4c353310494b

	measure 'MAPE King XGB' =
			CALCULATE(MAX('ModelMetrics'[MAPE (%)]), 'ModelMetrics'[Thị trường] = "King County", 'ModelMetrics'[Mô hình] = "XGBoost (tuned)")
		formatString: 0.0
		lineageTag: 31dc9fd9-1cee-49f5-bf33-0fd4e3def68d

	measure 'MAPE Ames XGB' =
			CALCULATE(MAX('ModelMetrics'[MAPE (%)]), 'ModelMetrics'[Thị trường] = "Ames", 'ModelMetrics'[Mô hình] = "XGBoost")
		formatString: 0.0
		lineageTag: cc8bf2ed-b99b-4236-8b01-0e16fc558fa0

	measure 'R2 King XGB' =
			CALCULATE(MAX('ModelMetrics'[R²]), 'ModelMetrics'[Thị trường] = "King County", 'ModelMetrics'[Mô hình] = "XGBoost (tuned)")
		formatString: 0.000
		lineageTag: 6a4dae65-899f-45b9-9098-d89c93ce44d1

	measure 'R2 Ames XGB' =
			CALCULATE(MAX('ModelMetrics'[R²]), 'ModelMetrics'[Thị trường] = "Ames", 'ModelMetrics'[Mô hình] = "XGBoost")
		formatString: 0.000
		lineageTag: cf339924-2e0e-4ee0-b06f-a8eb231821fa

	measure 'MAPE King Time XGB' =
			CALCULATE(MAX('ModelMetrics'[MAPE (%)]), 'ModelMetrics'[Thị trường] = "King County (chia theo thời gian)", 'ModelMetrics'[Mô hình] = "XGBoost (tuned)")
		formatString: 0.0
		lineageTag: fc816761-a512-4767-9667-556bb9e59887

	measure 'Ngân sách (USD)' =
			IF(ISFILTERED('NganSach'[Value]), MAX('NganSach'[Value]), 2000000)
		formatString: #,0
		lineageTag: a21c98d9-5aad-430d-b51e-2077b34da3e5

	measure 'Budget Bought' =
			VAR b = [Ngân sách (USD)]
			RETURN CALCULATE(COUNTROWS('BudgetPlan'), 'BudgetPlan'[Lũy kế (USD)] <= b)
		formatString: #,0
		lineageTag: e8c41907-603c-42f2-b38b-43ab4ed32fd7

	measure 'Budget Capital' =
			VAR b = [Ngân sách (USD)]
			RETURN CALCULATE(SUM('BudgetPlan'[Giá bán]), 'BudgetPlan'[Lũy kế (USD)] <= b)
		formatString: #,0
		lineageTag: e962a3a7-84d2-4e0c-9d10-2f4dc1da0d78

	measure 'Budget Upside' =
			VAR b = [Ngân sách (USD)]
			RETURN CALCULATE(SUM('BudgetPlan'[Chênh lệch (USD)]), 'BudgetPlan'[Lũy kế (USD)] <= b)
		formatString: #,0
		lineageTag: 97e1d4f3-88fc-4d52-a72c-0a4e95bc2f68

	measure 'Chỉ số đang chọn' =
			SWITCH(SELECTEDVALUE('ChonChiSo'[Chỉ số]),
			    "Giá trung vị nhóm", [Giá trung vị ứng viên],
			    "Chênh lệch kỳ vọng (USD)", [Chênh lệch ứng viên (USD)],
			    [Số ứng viên])
		formatString: #,0
		lineageTag: 7f0086d3-2b88-4034-aabd-32363b3498ca

	measure 'Budget Used' =
			DIVIDE([Budget Capital], [Ngân sách (USD)])
		formatString: 0.0%
		lineageTag: e7f174bd-b714-48af-b448-8c05e0ea4a42

	measure 'Budget ROI' =
			DIVIDE([Budget Upside], [Budget Capital])
		formatString: 0.0%
		lineageTag: ea2e7fc3-80ec-4e88-a477-879b5bbdadbc

	measure 'SelectedBudget Text' =
			FORMAT([Ngân sách (USD)], "#,##0")
		lineageTag: 704370dc-cf22-44ee-984c-6a84f60b2f19

	measure 'BudgetBought Text' =
			FORMAT([Budget Bought], "#,##0")
		lineageTag: 6371794b-ce4f-40d3-8819-049648ca904a

	measure 'BudgetCapital Text' =
			FORMAT([Budget Capital], "#,##0")
		lineageTag: 77db691c-20fb-4c54-b18d-287d8b303af6

	measure 'BudgetUpside Text' =
			FORMAT([Budget Upside], "#,##0")
		lineageTag: 1524428a-0fb6-4452-8016-5928f7aa2d18

	column Placeholder
		dataType: string
		isHidden
		sourceColumn: Placeholder
		lineageTag: d5ef2c6a-2f30-46f5-9604-cee7b0ad5a74

	partition KPI = m
		mode: import
		source =
			let
				Source = #table(type table [Placeholder = text], {{""}})
			in
				Source
