table KPI
	lineageTag: 2bcc0cfc-792d-4cf2-a065-61e4797ade94

	measure 'Số giao dịch' =
			COUNTROWS('KingSales')
		formatString: #,0
		lineageTag: 530e88a9-94a0-4296-9355-010b69eeb770

	measure 'King Properties' =
			DISTINCTCOUNT('KingSales'[Mã căn])
		formatString: #,0
		lineageTag: 52e6cefd-69ea-48fa-a71c-f3a39eec55b2

	measure 'Giá trung vị' =
			MEDIAN('KingSales'[Giá bán])
		formatString: #,0
		lineageTag: 680b7056-eeb6-4d90-b6aa-c2837a813e6a

	measure 'King OOF MAPE' =
			AVERAGEX('KingSales', ABS('KingSales'[Sai số (%)]))
		formatString: 0.0%
		lineageTag: 5f893e14-7cd5-40ed-8725-eb7d058d5c47

	measure 'Ngưỡng (%)' =
			VAR p = IF(ISFILTERED('Nguong'[Value]), MIN('Nguong'[Value]), 20)
			RETURN p / 100
		formatString: 0%
		lineageTag: b5097523-6f6d-4e47-8ac3-25f31f9a3852

	measure 'Candidate Base' =
			CALCULATE(COUNTROWS('KingSales'), 'KingSales'[Giao dịch mới nhất] = 1, 'KingSales'[Thiếu phòng] = 0, 'KingSales'[Tình trạng] >= 3)
		formatString: #,0
		lineageTag: 0ecf379c-fb43-408c-8e4b-228cd73e2fa0

	measure 'Số ứng viên' =
			VAR t = -[Ngưỡng (%)]
			RETURN CALCULATE([Candidate Base], 'KingSales'[Sai số (%)] <= t)
		formatString: #,0
		lineageTag: d0a108e3-356c-474e-84ee-e5d724f10d89

	measure 'Tỷ lệ ứng viên' =
			DIVIDE([Số ứng viên], [Candidate Base])
		formatString: 0.00%
		lineageTag: 958f7839-14fa-4417-8781-fd9859b9b2d0

	measure 'Chênh lệch ứng viên (USD)' =
			VAR t = -[Ngưỡng (%)]
			RETURN CALCULATE(SUM('KingSales'[Chênh lệch (USD)]), 'KingSales'[Giao dịch mới nhất] = 1, 'KingSales'[Thiếu phòng] = 0, 'KingSales'[Tình trạng] >= 3, 'KingSales'[Sai số (%)] <= t)
		formatString: #,0
		lineageTag: ec153994-9639-4c53-a668-ec9db2387e7c

	measure 'Giá trung vị ứng viên' =
			VAR t = -[Ngưỡng (%)]
			RETURN CALCULATE(MEDIAN('KingSales'[Giá bán]), 'KingSales'[Giao dịch mới nhất] = 1, 'KingSales'[Thiếu phòng] = 0, 'KingSales'[Tình trạng] >= 3, 'KingSales'[Sai số (%)] <= t)
		formatString: #,0
		lineageTag: 7eae3682-e8b3-49db-8b31-9e36b4a71f86

	measure 'Đồng thuận 3 mô hình' =
			VAR t = -[Ngưỡng (%)]
			RETURN CALCULATE(COUNTROWS('KingSales'), 'KingSales'[Giao dịch mới nhất] = 1, 'KingSales'[Thiếu phòng] = 0, 'KingSales'[Tình trạng] >= 3, 'KingSales'[Số mô hình đồng ý] = 3, 'KingSales'[Sai số (%)] <= t)
		formatString: #,0
		lineageTag: e8fec7ae-13a0-48fe-b97e-bda18c73b516

	measure 'Top20 Count' =
			COUNTROWS('Top20')
		formatString: #,0
		lineageTag: 35f1a525-6cdb-4462-b6d9-23ab5c8395cc

	measure 'Vốn Top20 (USD)' =
			SUM('Top20'[Giá bán])
		formatString: #,0
		lineageTag: 9af79dd5-fbef-4fc1-8e9c-54a598c3782b

	measure 'Chênh lệch Top20 (USD)' =
			SUM('Top20'[Chênh lệch (USD)])
		formatString: #,0
		lineageTag: 6fc80f62-216d-47ee-9fcb-e50242bd118a

	measure 'Mức giảm trung vị (%)' =
			MEDIAN('Top20'[Mức giảm (%)])
		formatString: 0.0"%"
		lineageTag: 84f3d8f3-f4cb-4009-ab9f-73cc305315d0

	measure 'Top20 All3' =
			COUNTROWS(FILTER('Top20', 'Top20'[Số mô hình đồng ý] = 3))
		formatString: #,0
		lineageTag: 11a0cacb-d249-4cad-9f47-af8bad1f005d

	measure 'MAPE tăng (điểm %)' =
			SUM('ImportanceTop'[MAPE tăng (điểm %)])
		formatString: 0.00
		lineageTag: fc3e91c1-5d91-4b73-a7eb-643a20b08384

	measure 'Thay đổi giá (%)' =
			SUM('WhatIfScenarios'[Thay đổi (%)])
		formatString: 0.00
		lineageTag: 9b80b933-bdae-426b-9e28-1015d0e02e73

	measure 'Số ứng viên theo ngưỡng' =
			SUM('Sensitivity'[Số ứng viên])
		formatString: #,0
		lineageTag: 28316dff-6843-4fa7-ae86-c7c466e7940e

	measure 'MAPE (%)' =
			SUM('ModelCompare'[MAPE (%)])
		formatString: 0.0
		lineageTag: 9301ff5e-12de-4e49-b531-fa382ffd4300

	measure 'KingTx Text' =
			FORMAT([Số giao dịch], "#,##0")
		lineageTag: 15e579c8-453f-4bba-8e98-ccda35e31589

	measure 'KingMedian Text' =
			FORMAT([Giá trung vị], "#,##0")
		lineageTag: 90a51bd4-d9d1-4215-987f-4d4e979805af

	measure 'Candidates Text' =
			FORMAT([Số ứng viên], "#,##0")
		lineageTag: f865a29f-823d-4f33-b434-50bbb1835d4a

	measure 'CandidateUpside Text' =
			FORMAT([Chênh lệch ứng viên (USD)], "#,##0")
		lineageTag: 0df6d3df-4e43-449c-9681-24b2c70397fe

	measure 'CandidateMedian Text' =
			FORMAT([Giá trung vị ứng viên], "#,##0")
		lineageTag: 27b6feb3-3933-478e-8590-da5494267022

	measure 'Top20Capital Text' =
			FORMAT([Vốn Top20 (USD)], "#,##0")
		lineageTag: fcf3293a-34ba-47c9-bdfc-f00a2522cde6

	measure 'Top20Upside Text' =
			FORMAT([Chênh lệch Top20 (USD)], "#,##0")
		lineageTag: 4bbdd812-a3c0-427e-9661-f4ce3f53d4ca

	measure 'Top20All3 Text' =
			FORMAT([Top20 All3], "#,##0")
		lineageTag: 951a29b3-f110-44cb-bcf3-c225b8f2669d

	measure 'AmesProperties Text' =
			FORMAT([Số tài sản Ames], "#,##0")
		lineageTag: d8cd9138-d56e-4dbe-8595-7f36297c466e

	measure 'AmesMedian Text' =
			FORMAT([Giá trung vị Ames], "#,##0")
		lineageTag: 46fbaa9b-ee8e-47d7-a1c9-424f0f03a364

	measure 'AmesCandidates Text' =
			FORMAT([Số ứng viên Ames], "#,##0")
		lineageTag: 4cabc834-7d49-4cf6-bc67-a76af81ab7bd

	measure 'Số tài sản Ames' =
			COUNTROWS('AmesSales')
		formatString: #,0
		lineageTag: 0715bcc3-c29e-4c50-9eab-89b7c5eded17

	measure 'Giá trung vị Ames' =
			MEDIAN('AmesSales'[Giá bán])
		formatString: #,0
		lineageTag: 0c73585c-fa95-4f8c-a611-0c6cc4a8603b

	measure 'Ames OOF MAPE' =
			AVERAGEX('AmesSales', ABS('AmesSales'[Sai số (%)]))
		formatString: 0.0%
		lineageTag: 1a1ff062-02c4-40ae-901e-a8457d688812

	measure 'Số ứng viên Ames' =
			VAR t = -[Ngưỡng (%)]
			RETURN CALCULATE(COUNTROWS('AmesSales'), 'AmesSales'[Sai số (%)] <= t)
		formatString: #,0
		lineageTag: f00fdef3-b9ac-4e3f-8daf-5e51d85d0e4a

	measure 'Ames Candidate Share' =
			DIVIDE([Số ứng viên Ames], [Số tài sản Ames])
		formatString: 0.00%
		lineageTag: 7e2fcc4b-e49b-4e88-9419-9e891df399e8

	measure 'MAPE King XGB' =
			CALCULATE(MAX('ModelMetrics'[MAPE (%)]), 'ModelMetrics'[Thị trường] = "King County", 'ModelMetrics'[Mô hình] = "XGBoost (tuned)")
		formatString: 0.0
		lineageTag: 46417fa3-b6c9-40a2-b884-f2bfba12fecf

	measure 'MAPE Ames XGB' =
			CALCULATE(MAX('ModelMetrics'[MAPE (%)]), 'ModelMetrics'[Thị trường] = "Ames", 'ModelMetrics'[Mô hình] = "XGBoost")
		formatString: 0.0
		lineageTag: 9afe3edb-d382-426d-81cb-02a823182720

	measure 'R2 King XGB' =
			CALCULATE(MAX('ModelMetrics'[R²]), 'ModelMetrics'[Thị trường] = "King County", 'ModelMetrics'[Mô hình] = "XGBoost (tuned)")
		formatString: 0.000
		lineageTag: 23303010-ee21-4407-8140-fa9a08a092e4

	measure 'R2 Ames XGB' =
			CALCULATE(MAX('ModelMetrics'[R²]), 'ModelMetrics'[Thị trường] = "Ames", 'ModelMetrics'[Mô hình] = "XGBoost")
		formatString: 0.000
		lineageTag: 81e25b5b-25fe-4802-9c63-cf53c8eb9063

	measure 'MAPE King Time XGB' =
			CALCULATE(MAX('ModelMetrics'[MAPE (%)]), 'ModelMetrics'[Thị trường] = "King County (chia theo thời gian)", 'ModelMetrics'[Mô hình] = "XGBoost (tuned)")
		formatString: 0.0
		lineageTag: 253ad712-8bd4-437c-ad7c-688b4a16f2f3

	measure 'Vĩ độ' =
			AVERAGE('KingSales'[Vĩ độ])
		formatString: 0.0000
		lineageTag: 5ae919d6-c631-447f-994a-f4225099bef3

	measure 'Kinh độ' =
			AVERAGE('KingSales'[Kinh độ])
		formatString: 0.0000
		lineageTag: 496211db-f322-4027-bfea-24f33f722f74

	measure 'Ngân sách (USD)' =
			IF(ISFILTERED('NganSach'[Value]), MAX('NganSach'[Value]), 2000000)
		formatString: #,0
		lineageTag: 708b7b6c-7233-4f10-988e-c6f63850a03d

	measure 'Budget Bought' =
			VAR b = [Ngân sách (USD)]
			RETURN CALCULATE(COUNTROWS('BudgetPlan'), 'BudgetPlan'[Lũy kế (USD)] <= b)
		formatString: #,0
		lineageTag: bea6d38c-fd03-49da-bcc2-4929bda000d0

	measure 'Budget Capital' =
			VAR b = [Ngân sách (USD)]
			RETURN CALCULATE(SUM('BudgetPlan'[Giá bán]), 'BudgetPlan'[Lũy kế (USD)] <= b)
		formatString: #,0
		lineageTag: 731c0926-cd65-4c3b-b10e-98ea44d9bfe6

	measure 'Budget Upside' =
			VAR b = [Ngân sách (USD)]
			RETURN CALCULATE(SUM('BudgetPlan'[Chênh lệch (USD)]), 'BudgetPlan'[Lũy kế (USD)] <= b)
		formatString: #,0
		lineageTag: 94f54db9-e79e-47bc-aa50-36902316ac79

	measure 'Chỉ số đang chọn' =
			SWITCH(SELECTEDVALUE('ChonChiSo'[Chỉ số]),
			    "Giá trung vị nhóm", [Giá trung vị ứng viên],
			    "Chênh lệch kỳ vọng (USD)", [Chênh lệch ứng viên (USD)],
			    [Số ứng viên])
		formatString: #,0
		lineageTag: 7d4eecf5-3be0-446b-a876-ac22a340a6a0

	measure 'Budget Used' =
			DIVIDE([Budget Capital], [Ngân sách (USD)])
		formatString: 0.0%
		lineageTag: 212907ae-0378-4a59-88be-bbb5deb9e9fa

	measure 'Budget ROI' =
			DIVIDE([Budget Upside], [Budget Capital])
		formatString: 0.0%
		lineageTag: 445be822-7b77-49e9-92c2-11be39bc12dc

	measure 'SelectedBudget Text' =
			FORMAT([Ngân sách (USD)], "#,##0")
		lineageTag: 4520df71-a6d3-47dd-9057-dba1952d1e0e

	measure 'BudgetBought Text' =
			FORMAT([Budget Bought], "#,##0")
		lineageTag: 71ed43d1-23aa-4115-be22-bd5afebb2061

	measure 'BudgetCapital Text' =
			FORMAT([Budget Capital], "#,##0")
		lineageTag: 48661694-0537-4e04-8731-0e9973eb7f7d

	measure 'BudgetUpside Text' =
			FORMAT([Budget Upside], "#,##0")
		lineageTag: 698af431-431a-4671-92a0-3f26f14460d9

	column Placeholder
		dataType: string
		isHidden
		sourceColumn: Placeholder
		lineageTag: 81ba55e8-d26e-4875-b966-a8601fe9a2e7

	partition KPI = m
		mode: import
		source =
			let
				Source = #table(type table [Placeholder = text], {{""}})
			in
				Source
