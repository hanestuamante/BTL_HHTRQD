	partition AmesSales = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\fact_ames.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"pid", type text},
					{"neighborhood", type text},
					{"price", Int64.Type},
					{"gr_liv_area", Int64.Type},
					{"overall_qual", Int64.Type},
					{"year_built", Int64.Type},
					{"house_age", Int64.Type},
					{"bedroom_abvgr", Int64.Type},
					{"garage_cars", type number},
					{"lot_area", Int64.Type},
					{"yr_sold", Int64.Type},
					{"bathrooms_total", type number},
					{"predicted_price", type number},
					{"residual_pct", type number},
					{"discount_pct", type number},
					{"upside_usd", type number},
					{"price_band", type text},
					{"is_undervalued_20pct", Int64.Type},
					{"neighborhood_top", type text}
					}),
				Result = Typed
			in
				Result
