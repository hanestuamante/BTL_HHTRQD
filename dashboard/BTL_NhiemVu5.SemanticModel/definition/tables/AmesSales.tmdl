	partition AmesSales = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\fact_ames.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"pid", type text},
					{"neighborhood", type text},
					{"price", Int64.Type},
					{"gr_liv_area", Int64.Type},
					{"overall_qual", Int64.Type},
