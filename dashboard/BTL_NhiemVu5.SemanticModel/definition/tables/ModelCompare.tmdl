table ModelCompare
	lineageTag: 4aeba538-1770-44ba-a745-f2b592e74443

	column 'Mô hình'
		dataType: string
		sourceColumn: model
		lineageTag: e688f525-4ea5-4f70-9751-5196cf6ca6ff
	column 'Thị trường'
		dataType: string
		sourceColumn: market
		lineageTag: 1057d0d7-3761-4cfb-a3bb-563580905a01
	column 'MAPE (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape
		lineageTag: 741a9e15-7938-49c2-b4b5-4466a96e693b

	partition ModelCompare = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\model_compare_long.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"model", type text},
					{"market", type text},
					{"mape", type number}
					}),
				Result = Typed
			in
				Result
