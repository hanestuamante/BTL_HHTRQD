table ModelCompare
	lineageTag: 6c261458-f7ee-44cd-a2b5-f6ea9f0f4717

	column 'Mô hình'
		dataType: string
		sourceColumn: model
		lineageTag: ae472d65-da3c-4b57-ab96-8377dceb2ba6
	column 'Thị trường'
		dataType: string
		sourceColumn: market
		lineageTag: b068e076-5985-4c2f-a4c2-b1997fac0591
	column 'MAPE (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape
		lineageTag: b7ceb2ec-6e09-4113-ad55-b41298dc3eaa

	partition ModelCompare = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\model_compare_long.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"model", type text},
					{"market", type text},
					{"mape", type number}
					}),
				Result = Typed
			in
				Result
