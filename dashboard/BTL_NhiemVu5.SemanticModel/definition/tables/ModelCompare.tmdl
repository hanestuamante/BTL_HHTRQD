table ModelCompare
	lineageTag: 1d4b3244-4581-4fe0-9e78-448b758f2335

	column 'Mô hình'
		dataType: string
		sourceColumn: model
		lineageTag: ffb6fee6-7588-4531-bde6-ad87ce7d8554
	column 'Thị trường'
		dataType: string
		sourceColumn: market
		lineageTag: c6f28e55-9906-43cd-bd8f-068aa6fc5dc8
	column 'MAPE (%)'
		dataType: double
		summarizeBy: sum
		sourceColumn: mape
		lineageTag: 6861f8c8-5809-4200-855a-481a5cd9df4b

	partition ModelCompare = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\model_compare_long.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"model", type text},
					{"market", type text},
					{"mape", type number}
					}),
				Result = Typed
			in
				Result
