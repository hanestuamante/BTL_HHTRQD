table ModelCompare
	lineageTag: 66184dc7-5d1a-411c-a71a-12f1e146604e

	column model
		dataType: string
		sourceColumn: model
		lineageTag: b8e5c619-9f5b-4a9d-a3d6-f51012d58e6d
	column market
		dataType: string
		sourceColumn: market
		lineageTag: 1aba9f6d-3844-463b-87e5-15bfccbff06d
	column mape
		dataType: double
		summarizeBy: sum
		sourceColumn: mape
		lineageTag: 95ff1bca-12a6-44af-bf40-99b562edabae

	partition ModelCompare = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\model_compare_long.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"model", type text},
					{"market", type text},
					{"mape", type number}
					}),
				Result = Typed
			in
				Result
