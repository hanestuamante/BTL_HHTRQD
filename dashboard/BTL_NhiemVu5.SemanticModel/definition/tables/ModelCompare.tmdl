table ModelCompare
	lineageTag: 5817c4db-1492-426b-91a9-0f3151b9f93a

	column model
		dataType: string
		sourceColumn: model
		lineageTag: 44c199de-3d49-4416-b000-2c58c31b946d
	column market
		dataType: string
		sourceColumn: market
		lineageTag: 0e58ade6-e347-43a4-913c-1866a947200f
	column mape
		dataType: double
		summarizeBy: sum
		sourceColumn: mape
		lineageTag: 51c68119-6ee0-4fee-b8c1-d4b81be6d55b

	partition ModelCompare = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\model_compare_long.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted,
					{
					{"model", type text},
					{"market", type text},
					{"mape", type number}
					}),
				Result = Typed
			in
				Result
