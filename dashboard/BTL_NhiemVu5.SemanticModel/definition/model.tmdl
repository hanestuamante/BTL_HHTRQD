model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

	annotation PBI_QueryOrder = ["KingSales", "AmesSales", "Top20", "ModelMetrics", "ModelCompare", "SegmentCompare", "Sensitivity", "ImportanceTop", "Stability", "WhatIfScenarios"]

	annotation __PBI_TimeIntelligenceEnabled = 0

ref table KingSales
ref table AmesSales
ref table Top20
ref table ModelMetrics
ref table ModelCompare
ref table SegmentCompare
ref table Sensitivity
ref table ImportanceTop
ref table Stability
ref table WhatIfScenarios
ref table KPI
ref table Nguong

ref cultureInfo en-US
