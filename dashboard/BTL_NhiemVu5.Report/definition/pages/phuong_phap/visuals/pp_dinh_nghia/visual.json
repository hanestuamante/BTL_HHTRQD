                  {
                    "value": "residual_pct = (giá bán − giá mô hình) / giá mô hình. Giá trị âm nghĩa là bán dưới giá mô hình dự báo.",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#1B2A3A"
