                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Ứng viên = residual_pct ≤ −ngưỡng, tính trong phạm vi 21.229 giao dịch nêu trên.",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#1B2A3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "upside_usd = giá mô hình − giá bán: chênh lệch kỳ vọng tính bằng USD.",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#1B2A3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "discount_pct = mức giảm theo mô hình bảo thủ nhất trong 3 mô hình (%).",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#1B2A3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Đồng thuận = cả 3 mô hình cùng gắn cờ định giá thấp tại ngưỡng đang chọn.",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#1B2A3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Top 20 = 20 căn giảm sâu nhất theo discount_pct; 36 giao dịch giảm trên 50% bị loại sang danh sách cần xác minh thủ công.",
                    "textStyle": {
                      "fontSize": "12.5pt",
                      "color": "#1B2A3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Ngưỡng = tham số What-if, thanh trượt 5%–50% bước 1%; mặc định 20%.",
                    "textStyle": {
                      "fontSize": "12.5pt",
